{
  "commands": [
    {"command": "parameters.add", "params": {"name": "D_OUT", "expression": "180", "unit": "mm", "comment": "outer diameter"}},
    {"command": "parameters.add", "params": {"name": "H", "expression": "30", "unit": "mm", "comment": "overall height"}},
    {"command": "parameters.add", "params": {"name": "T", "expression": "1", "unit": "mm", "comment": "wall thickness"}},
    {"command": "parameters.add", "params": {"name": "D_HOLE", "expression": "110", "unit": "mm", "comment": "opening in ceiling-side face"}},
    {"command": "parameters.add", "params": {"name": "W_RIB", "expression": "20", "unit": "mm", "comment": "solid rib width"}},

    {"command": "solid.cylinder", "params": {"diameter": "D_OUT", "height": "H", "base": [0, 0, 0], "operation": "new", "body_name": "Spacer"}},

    {"command": "solid.cylinder", "params": {"diameter": "D_OUT - 2 * T", "height": "H - 2 * T", "base": [0, 0, "T"], "operation": "cut", "targets": ["Spacer"]}},

    {"command": "solid.cylinder", "params": {"diameter": "D_HOLE", "height": "T + 2", "base": [0, 0, "H - T - 1"], "operation": "cut", "targets": ["Spacer"]}},

    {"command": "solid.cylinder", "params": {"diameter": "D_OUT - 1", "height": "H - T", "base": [0, 0, "T"], "operation": "new", "body_name": "RibTrim"}},
    {"command": "solid.box", "params": {"length": "D_OUT + 40", "width": "W_RIB", "height": "H - T", "center": [0, 0, "(H + T) / 2"], "operation": "new", "body_name": "Rib"}},
    {"command": "solid.combine", "params": {"target": "Rib", "tools": ["RibTrim"], "operation": "intersect"}},
    {"command": "solid.combine", "params": {"target": "Spacer", "tools": ["Rib"], "operation": "join"}}
  ]
}
